{
  "name": "dronexperience",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.18.0" },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "test": "node --test server/test/validation.test.js server/test/integration.test.js",
    "db:audit": "node server/scripts/audit-db.js",
    "format": "prettier --write client/src server/src server/test server/scripts",
    "test:integration": "node server/scripts/test-integration.js",
    "test:browser": "node server/scripts/qa-browser.js",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0"
  }
}
